# Text the build compares byte for byte must not change shape on checkout.
# The diagnostics golden is regenerated by `badc --list-diagnostics`, which
# writes LF on every platform, and a test compares it with that output.
tests/diagnostics/*.txt text eol=lf
# Assembly and SSA snapshots are regenerated and diffed the same way.
tests/snapshots/** text eol=lf
